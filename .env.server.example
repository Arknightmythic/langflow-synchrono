# Salin jadi .env DI FOLDER INI (sebelah docker-compose.server.yml):
#     cp .env.server.example .env
#
# Yang wajib: PG_HOST, PG_PASSWORD, S3_ENDPOINT, S3_RELAY_TARGET. Sisanya punya
# nilai bawaan yang aman.

# Nama proyek compose. Harus beda dari stack lain di server yang sama supaya
# nama jaringan dan volume tidak bertabrakan.
COMPOSE_PROJECT_NAME=synchrono-service

# ── PostgreSQL ENGINE (grading_jobs, grade_rules, cache reasoning, ...) ─────
# Server 192.168.2.107: container synchrono-postgres, port host 5430.
PG_HOST=192.168.2.107
PG_PORT=5430
PG_DB=synchrono
PG_USER=root
PG_PASSWORD=

# ── SeaweedFS (berkas unggahan, parquet, rujukan wilayah) ───────────────────
# Server 192.168.2.107: container synchrono-seaweedfs, port host 8355.
S3_ENDPOINT=192.168.2.107:8355
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Alamat yang dituju penerus S3 milik konverter. Hampir selalu = S3_ENDPOINT.
S3_RELAY_TARGET=192.168.2.107:8355
# 0 = kode kecamatan tak dikenal hanya dilaporkan; 1 = membuat NIK tidak tepercaya.
WILAYAH_KECAMATAN_TEGAS=0

# ── DB PORTAL: tujuan penyuntikan hasil matching ────────────────────────────
# Kosong = setiap job matching gagal dengan pesan yang menyebut variabel ini.
# Contoh: host=192.168.2.15 port=5432 dbname=syncrono_db user=... password=...
PORTAL_PG_DSN=
MATCHING_MAX_CONCURRENT=1

# ── Reasoning matching (kolom `reasoning`) ─────────────────────────────────
# Kosong = kalimat deterministik, tanpa LLM. Alamat luar (https://ollama.com)
# hanya diterima kalau REASONING_AI_ALLOW_EXTERNAL=1.
REASONING_AI_BASE_URL=
REASONING_AI_MODEL=gemma4:31b
REASONING_AI_API_KEY=
REASONING_AI_ALLOW_EXTERNAL=0

# ── Normalisasi AI — alamat TANPA /v1 ──────────────────────────────────────
NORMALISASI_AI=nama_saja
NORMALISASI_AI_MODEL=gemma4:31b
NORMALISASI_AI_BASE_URL=
OLLAMA_API_KEY=ollama

# ── DuckDB & grading ────────────────────────────────────────────────────────
# Batas memori DuckDB WAJIB di container — tanpanya berkas besar bisa membuat
# container dibunuh kernel (exit 137). Setel ~60% memori container.
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_TEMP_DIR=/tmp/duckdb_spill
DUCKDB_POOL_SIZE=4
GRADING_MAX_CONCURRENT=2

# ── synchrono-service ───────────────────────────────────────────────────────
# 7860 = menggantikan Langflow (portal tidak berubah); 8000 = berdampingan.
SERVICE_PORT=7860
SERVICE_SUPERUSER=admin
# Kosong = login dimatikan (hanya API key). Isi kalau portal login dulu.
SERVICE_SUPERUSER_PASSWORD=
# Kunci sk-... yang sekarang disetel di portal. Boleh beberapa, dipisah koma.
SERVICE_API_KEY=
# String acak panjang (openssl rand -hex 32) — token login bertahan lewat restart.
SERVICE_SECRET_KEY=

# ── Konverter jalur B ───────────────────────────────────────────────────────
# Sandi basis data SEKALI PAKAI di dalam container konverter. Tidak pernah
# terhubung ke luar, tapi tetap ganti dari nilai contoh.
KONV_PG_PASSWORD=konversi_lokal
KONV_MSSQL_PASSWORD=Konversi_Lokal_12345!
KONV_ORACLE_PASSWORD=Konversi_Lokal_12345
KONV_MYSQL_PASSWORD=Konversi_Lokal_12345
KONV_BATAS_MB=4096
KONV_BATAS_DETIK=1800
KONV_MAX_CONCURRENT=1
