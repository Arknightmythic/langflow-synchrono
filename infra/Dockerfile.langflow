# Langflow + dependency service matching.
#
# Image resmi Langflow tidak membawa duckdb, sementara SELURUH pipeline matching
# berjalan di atasnya. Hanya satu paket yang perlu ditambahkan — tidak ada
# Polars, rapidfuzz, pymysql, maupun client S3, karena DuckDB sudah menangani
# parquet di S3, koneksi PostgreSQL, dan jaro_winkler_similarity sekaligus.
#
# Menjalankan Langflow di container juga menyelesaikan masalah nyata di mesin
# Windows ini: DLL `_xxhash` diblokir Application Control policy sehingga
# `import langflow` gagal di venv host. Di dalam container, kebijakan itu tidak
# berlaku.

FROM langflowai/langflow:latest

USER root

# Versi dipatok agar hasil matching tidak bergeser diam-diam saat image di-rebuild.
RUN pip install --no-cache-dir duckdb==1.5.5 python-dotenv==1.2.3

# Extension DuckDB diunduh saat pertama dipakai. Diunduh di sini supaya
# container tidak perlu akses internet saat runtime dan eksekusi flow pertama
# tidak tertunda.
#
#   httpfs    membaca parquet/CSV langsung dari S3
#   postgres  ATTACH ke PostgreSQL
#   excel     membaca unggahan .xlsx
#
# `excel` ikut DIPASANG di sini tapi TIDAK di-LOAD di `buka_koneksi()`. Yang
# memuatnya hanya job yang berkasnya memang .xlsx (`_muat_excel` di
# lib/_grading.py), supaya kalau extension ini bermasalah yang terhenti hanya
# job xlsx — bukan matching dan config yang tidak ada urusannya dengan Excel.
RUN python -c "import duckdb; c=duckdb.connect(); [c.execute(f'INSTALL {e}') for e in ('httpfs','postgres','excel')]"

# Folder data Langflow dibuat & dimiliki user (uid 1000, grup root/0) SEBELUM
# volume di-mount. WAJIB di server Linux: image ini berjalan sebagai user
# non-root, tapi Docker membuat named volume sebagai root:root — sehingga
# Langflow gagal menulis /app/langflow-data/secret_key dengan
# "PermissionError: [Errno 13]". Di Docker Desktop tidak terlihat karena izin
# volumenya longgar; di Linux terlihat.
#
# Named volume yang MASIH KOSONG mewarisi kepemilikan folder ini saat pertama
# di-mount — jadi volume baru langsung bisa ditulis. (Volume lama yang teranjur
# dibuat root harus dihapus dulu: docker compose ... down -v.)
RUN mkdir -p /app/langflow-data \
 && chown -R 1000:0 /app/langflow-data \
 && chmod -R g+rwX /app/langflow-data

USER user
