# Salin jadi .env di folder infra/ sebelum menjalankan docker-compose.server.yml:
#     cp .env.server.example .env
#
# HANYA kata sandi PG yang wajib diisi. Sisanya sudah benar untuk server
# 172.16.12.98 dan boleh dibiarkan.
#
# DUA BENTUK SERVER, SATU BERKAS COMPOSE
#
# SeaweedFS dan PostgreSQL di sini adalah penyimpanan BACKEND pipeline. Di
# server lama keduanya dipasang langsung di host; di server baru keduanya
# container di compose yang berbeda (docker-compose.infra.yml). Dua-duanya
# dijangkau lewat IP host, jadi yang berubah HANYA alamat di berkas ini:
#
#     server lama (172.16.12.98)    PG :5430   S3 :8333
#     server baru (192.168.2.107)   PG :5430   S3 :8355
#
# Tidak ada percabangan di compose-nya.

# ── PostgreSQL server (WAJIB) ───────────────────────────────────────────────
PG_HOST=172.16.12.98
# PERHATIKAN: PostgreSQL server ada di 5430, BUKAN 5432 yang lazim.
PG_PORT=5430
PG_DB=synchrono
PG_USER=root
# Isi kata sandi PostgreSQL server di sini. Tanpa ini semua endpoint balas 500.
PG_PASSWORD=

# ── SeaweedFS server ────────────────────────────────────────────────────────
S3_ENDPOINT=172.16.12.98:8333
S3_ACCESS_KEY=ADMIN
S3_SECRET_KEY=Password1234

# Alamat yang DITUJU penerus S3. Hampir selalu sama dengan S3_ENDPOINT di atas,
# dan harus diisi terpisah karena compose tidak bisa memakai satu variabel
# sebagai nilai bawaan variabel lain.
#
# Kenapa ada penerus: layanan konversi berada di jaringan `internal` yang tidak
# punya rute ke mana pun — termasuk ke host. Itu disengaja, supaya berkas tidak
# tepercaya yang dipulihkannya tidak bisa mengirim apa pun keluar. Penerus ini
# satu-satunya jalan, dan ia cuma meneruskan SATU port ke SATU alamat.
S3_RELAY_TARGET=172.16.12.98:8333

# ── Layanan konversi jalur B (.sql / .mdf / .dmp) ───────────────────────────
# Kata sandi basis data SEKALI PAKAI di dalam container konverter. Tidak pernah
# terhubung ke luar dan dibuang tiap job, tapi tetap ganti dari nilai contoh.
KONV_PG_PASSWORD=konversi_lokal
KONV_MSSQL_PASSWORD=Konversi_Lokal_12345!
KONV_ORACLE_PASSWORD=Konversi_Lokal_12345
KONV_MYSQL_PASSWORD=Konversi_Lokal_12345

# Batas ukuran berkas yang dikonversi. Bukan batas memori — unduhannya mengalir
# ke disk — melainkan batas WAKTU: pada ~82 bita/baris, 4096 MB kira-kira 52
# juta baris, dan pemulihannya bisa berjam-jam. Turunkan kalau pengguna tidak
# boleh menunggu selama itu.
KONV_BATAS_MB=4096
KONV_BATAS_DETIK=1800
KONV_MAX_CONCURRENT=1

# ── Kredensial admin Langflow ───────────────────────────────────────────────
# GANTI dari nilai pengembangan sebelum dibuka ke jaringan.
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=synchrono123

# ── Rujukan wilayah ─────────────────────────────────────────────────────────
# 0 = kode kecamatan tak dikenal hanya dilaporkan (aman untuk data dummy).
# 1 = kode tak dikenal membuat NIK tidak tepercaya (untuk data Dukcapil asli).
WILAYAH_KECAMATAN_TEGAS=0

# ── Batas memori DuckDB (PENTING untuk berkas besar) ────────────────────────
# Tanpa ini, DuckDB tidak melihat batas cgroup container dan bisa dibunuh
# kernel (exit 137) pada berkas berjuta baris. Setel ~60% memori container.
# Terukur: batas 3GB membuat 10 juta baris x 35 kolom selesai memakai 3,5 GB.
DUCKDB_MEMORY_LIMIT=3GB
DUCKDB_TEMP_DIR=/tmp/duckdb_spill

# ── Grading ─────────────────────────────────────────────────────────────────
GRADING_MAX_CONCURRENT=2

# ── Normalisasi AI (opsional) ───────────────────────────────────────────────
# Kosong = AI mati (aman). Untuk menyalakan lewat Ollama on-prem server:
#   NORMALISASI_AI_BASE_URL=http://172.16.12.98:11434/v1
NORMALISASI_AI=nama_saja
NORMALISASI_AI_MODEL=gemma4:31b
NORMALISASI_AI_BASE_URL=
OLLAMA_API_KEY=ollama

# ── Matching: DB PORTAL tujuan penyuntikan hasil ────────────────────────────
# Database yang memuat tabel syncrono_matching_job & syncrono_matching_result
# MILIK PORTAL (bukan database engine di PG_HOST). Engine hanya butuh:
#   SELECT, UPDATE  pada syncrono_matching_job
#   DELETE, INSERT  pada syncrono_matching_result
#
# SENGAJA KOSONG sampai kredensialnya diberikan. Kosong berarti setiap job
# matching gagal dengan pesan yang menyebut variabel ini — bukan menyuntik ke
# database yang salah.
#
# Contoh: PORTAL_PG_DSN=host=10.0.0.5 port=5432 dbname=portal user=engine_matching password=...
PORTAL_PG_DSN=

# Job matching yang boleh berjalan bersamaan. Matching memegang incoming, hash
# table tiap pass, dan agregasi sekaligus; dua job berbarengan berebut memori.
MATCHING_MAX_CONCURRENT=1

# ── Reasoning matching (kolom `reasoning`) ─────────────────────────────────
# KOSONG = tanpa LLM. Kalimat tetap lengkap — disusun deterministik dari
# perbandingan per elemen — dan tidak ada yang menyentuh database.
#
# Diisi = LLM memperhalus bahasa kalimat itu, satu panggilan per POLA baru
# (bukan per baris), hasilnya disimpan di tabel reasoning_patterns (migrasi
# 005, diterapkan otomatis oleh service skema). LLM TIDAK PERNAH menerima
# nilai baris: yang dikirim hanya kalimat berplaceholder seperti
# "nama ('{incoming.nama}' vs '{master.nama}')". Hanya alamat on-prem yang
# diterima (IP privat, loopback, atau nama layanan Docker); https://ollama.com
# ditolak kecuali REASONING_AI_ALLOW_EXTERNAL=1 disetel secara sadar.
#
# Contoh on-prem: REASONING_AI_BASE_URL=http://172.16.12.98:11434
# Contoh cloud:   REASONING_AI_BASE_URL=https://ollama.com
#                 REASONING_AI_MODEL=gemma4:31b
#                 REASONING_AI_API_KEY=<kunci ollama.com>
#                 REASONING_AI_ALLOW_EXTERNAL=1
REASONING_AI_BASE_URL=
REASONING_AI_MODEL=gemma3:12b
REASONING_AI_API_KEY=
REASONING_AI_ALLOW_EXTERNAL=0
# Batas per job; pola yang tidak kebagian memakai kalimat deterministik dan
# mendapat giliran di job berikutnya.
REASONING_AI_MAX_PATTERNS_PER_JOB=25
REASONING_AI_BUDGET_SECONDS=90
