# Layanan konversi jalur B untuk `.mdf` — SQL Server sekali pakai + DuckDB.
#
# Berdiri TERPISAH dari konverter PostgreSQL, bukan digabung. Tiap mesin basis
# data datang dengan image, cara inisialisasi, dan lisensinya sendiri; memaksa
# ketiganya ke dalam satu container berarti satu container yang gagal karena
# alasan mana pun menghentikan ketiga formatnya sekaligus.
#
# Keputusan "satu container berumur panjang, database dibuang tiap job" tetap
# berlaku apa adanya — hanya saja ada satu container seperti itu per mesin.
FROM mcr.microsoft.com/mssql/server:2022-latest

USER root

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Versi dipatok sama dengan engine grading, alasan yang sama: parquet yang
# ditulis di sini harus bisa dibaca di sana tanpa kejutan versi format.
RUN pip install --no-cache-dir duckdb==1.5.5 python-dotenv==1.2.3

# Extension diunduh saat build; container ini berjalan tanpa akses internet.
#
#   httpfs  mengambil .mdf dari S3, menulis parquet ke S3
#   odbc    menembak SQL Server langsung dari DuckDB
#
# `odbc` dipakai karena DuckDB TIDAK punya extension SQL Server seperti
# `postgres` — sudah diperiksa: `sqlserver`, `mssql`, dan `tds` tidak ada.
# Tanpanya, satu-satunya jalan keluar adalah mengekspor lewat bcp ke TSV, dan
# itu memaksa kita membuang karakter kendali dari data supaya pemisahnya tidak
# rusak. Lewat ODBC nilainya berpindah apa adanya.
#
# HOME disetel ke rumah user `mssql`, bukan root. Container ini berjalan sebagai
# `mssql`, dan DuckDB mencari extension di `$HOME/.duckdb` — kalau dipasang ke
# `/root/.duckdb`, saat runtime ia gagal dengan "Can't find the home directory
# at '/home/mssql'". Ditemukan dengan menjalankannya.
ENV HOME=/var/opt/mssql
RUN python -c "import duckdb; c=duckdb.connect(); [c.execute(f'INSTALL {e}') for e in ('httpfs','odbc')]"  && chown -R mssql /var/opt/mssql/.duckdb

COPY konverter/ /konverter/
ENV PYTHONPATH=/konverter:/synchrono/lib \
    PYTHONUNBUFFERED=1 \
    KONV_MESIN=sqlserver

COPY infra/konverter-mssql-nyalakan.sh /usr/local/bin/konverter-nyalakan.sh
RUN chmod +x /usr/local/bin/konverter-nyalakan.sh

# Folder data dibuat & dimiliki `mssql` SEBELUM volume di-mount. Named volume
# yang MASIH KOSONG mewarisi kepemilikan folder ini saat pertama dipasang; tanpa
# ini Docker membuatnya root:root dan SQL Server mati dengan
# `BootstrapSystemDataDirectories() failure (HRESULT 0x80070005)` — pesan yang
# tidak menyebut izin sama sekali.
#
# Persoalan yang sama persis dengan volume langflow-data di Dockerfile.langflow.
RUN mkdir -p /var/opt/mssql/data /var/opt/mssql/log /var/opt/mssql/secrets  && chown -R mssql /var/opt/mssql

EXPOSE 8391
USER mssql
ENTRYPOINT ["/usr/local/bin/konverter-nyalakan.sh"]
