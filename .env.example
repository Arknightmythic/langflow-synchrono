# Salin jadi .env — nilainya sama persis dengan data-matching/.env
# cp ../data-matching/.env .env

# ── StarRocks ──────────────────────────────────────────────
# Dibutuhkan 4 dari 5 sumber data matching: metadata file, tabel master,
# matching_queries, dan grade_rules. Butuh akses BACA dan TULIS.
STARROCKS_HOST=
STARROCKS_PORT=9030
STARROCKS_USER=
STARROCKS_PASSWORD=
STARROCKS_DATABASE=synchrono

# ── MinIO / S3 ─────────────────────────────────────────────
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
# Bucket S3 yang sesungguhnya
RAW_BUCKET_NAME=raw
# BUKAN bucket terpisah — prefix folder di DALAM RAW_BUCKET_NAME,
# dan sudah termasuk dalam nilai kolom minio_path
CURATED_BUCKET_NAME=curated

# ── Lokasi paket backend ───────────────────────────────────
# Wajib diisi kalau folder data-matching TIDAK sejajar dengan folder ini,
# mis. saat Langflow jalan di container.
# SYNCHRONO_BACKEND_PATH=/backend
