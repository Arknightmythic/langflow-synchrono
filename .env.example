# Port UI di host.
UI_PORT=7880

# Service yang dikonfigurasi lewat UI ini. Satu atau lebih, dipisah koma,
# berbentuk Nama=URL (nama boleh dihilangkan). Hanya /api/v1/config/ yang
# diteruskan ke service; endpoint lain tidak bisa dijangkau lewat UI.
#   satu service : SERVICE_TARGETS=http://192.168.2.107:7860
#   dua service  : SERVICE_TARGETS=DuckDB=http://192.168.2.107:7860,StarRocks=http://192.168.2.107:7870
SERVICE_TARGETS=DuckDB=http://192.168.2.107:7860,StarRocks=http://192.168.2.107:7870

# API key (x-api-key) per target, urutan sama dengan SERVICE_TARGETS.
# Satu nilai = dipakai semua target. Kosong = pengguna mengisinya di browser.
SERVICE_API_KEYS=

# Login UI (basic auth). WAJIB diisi bila SERVICE_API_KEYS diisi, karena
# siapa pun yang bisa membuka UI akan bisa mengubah konfigurasi; tanpa itu
# kontainer menolak start.
UI_USER=admin
UI_PASSWORD=

# Hanya untuk uji lokal: izinkan kunci diisi server tanpa login UI.
UI_ALLOW_NO_LOGIN=
