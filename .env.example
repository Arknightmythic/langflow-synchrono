# Seluruh konfigurasi service ada di docker-compose.yml, bukan di sini.
#
# Berkas ini hanya untuk MENIMPA sebagian nilainya tanpa menyunting compose —
# berguna saat membandingkan dua setelan berturut-turut. Salin jadi `.env`
# lalu tambahkan `env_file: .env` pada service di docker-compose.yml.

# ── Lapisan HTTP ────────────────────────────────────────────────────────────
# 1 = setanding dengan Langflow yang juga satu proses.
# PERHATIKAN: di atas 1, GRADING_MAX_CONCURRENT berlaku PER PROSES.
WEB_CONCURRENCY=1
# 1 menyalakan log akses, menutup satu perbedaan kecil dengan Langflow.
ACCESS_LOG=0
# Kosongkan untuk mematikan pemeriksaan kunci — hanya untuk mesin lokal.
SERVICE_API_KEY=synchrono-bench-key

# ── Koneksi DuckDB ──────────────────────────────────────────────────────────
#   kolam        dipakai ulang         <- service yang sesungguhnya
#   per_request  buka-tutup tiap kali  <- setara persis Langflow
DUCKDB_MODE=kolam
DUCKDB_POOL_SIZE=8
DUCKDB_POOL_TIMEOUT=30
WARMUP_CONNECTIONS=2

# ── Harus sama dengan stack Langflow ────────────────────────────────────────
PG_DSN=host=host.docker.internal port=5432 dbname=synchrono user=postgres
S3_ENDPOINT=seaweedfs:8333
S3_ACCESS_KEY=synchrono
S3_SECRET_KEY=synchrono123
S3_USE_SSL=false

# ── Rujukan wilayah ─────────────────────────────────────────────────────────
# Endpoint dikosongkan = dibaca dari SeaweedFS yang sama dengan berkas unggahan.
WILAYAH_PARQUET=s3://syncrono-master/wilayah/master_wilayah_nik.parquet
WILAYAH_S3_ENDPOINT=
WILAYAH_S3_KEY=
WILAYAH_S3_SECRET=
# Nyalakan (1) begitu data Dukcapil yang sesungguhnya masuk.
WILAYAH_KECAMATAN_TEGAS=0

# ── Grading ─────────────────────────────────────────────────────────────────
GRADING_MAX_CONCURRENT=2
GRADING_STALE_MINUTES=15
GRADING_CALLBACK_RETRIES=3
GRADING_CALLBACK_TIMEOUT=20

# ── Normalisasi ─────────────────────────────────────────────────────────────
# Kosongkan BASE_URL selama benchmark: satu panggilan LLM ~1,3 detik dengan
# sebaran lebar, dan grafik latency yang terbaca jadi grafik latency Ollama.
NORMALISASI_AI=nama_saja
NORMALISASI_AI_BASE_URL=

# ── Penyiapan SeaweedFS lokal (infra/siapkan_seaweed.py) ────────────────────
# Sumber salinan rujukan wilayah. Butuh VPN, sekali saja.
SIAP_SERVER_ENDPOINT=172.16.12.98:8333
SIAP_SERVER_KEY=ADMIN
SIAP_SERVER_SECRET=Password1234
