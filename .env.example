STARROCKS_HOST=192.168.2.107
STARROCKS_PORT=30930
STARROCKS_USER=root
STARROCKS_PASSWORD=
STARROCKS_STREAM_LOAD_URL=http://192.168.2.107:30888
STARROCKS_REPLICATION=1
STARROCKS_BUCKETS=8
STARROCKS_ENABLE_SPILL=true
# Batas memori per kueri, hanya untuk koneksi service ini (mis. 16GB); kosong = batas BE.
STARROCKS_QUERY_MEM_LIMIT=
# Pass 3 dipecah per bagian berisi sekitar sekian pasangan kandidat agar muat di memori BE; 0 = tidak dipecah.
STARROCKS_PASS3_TARGET_PAIRS=20000000
# Setiap bagian memindai master lagi, jadi Pass 3 hanya dipecah bila pasangan kandidat lebih dari ini.
STARROCKS_PASS3_SPLIT_ABOVE_PAIRS=40000000
# Pasangan kandidat hanya dihitung (satu join tambahan) untuk master sebesar ini ke atas.
STARROCKS_PASS3_MIN_MASTER_ROWS=5000000

# Tabel service, K/L, dan portal ada di satu database, dengan awalan nama tabel
# syncrono_service_, syncrono_kl_, dan syncrono_portal_. Master punya database sendiri.
DB_STARROCK=syncrono_starrock
DB_MASTER=syncrono_master
# Hapus data K/L (syncrono_kl_records) sebuah berkas setelah job matching-nya selesai, di latar
# (task kl.release). Matching berikutnya memuatnya lagi dari enriched.parquet. false = simpan.
KL_DROP_AFTER_MATCHING=true

S3_ENDPOINT=seaweedfs:8333
S3_ACCESS_KEY=synchrono
S3_SECRET_KEY=synchrono123
S3_USE_SSL=false

WILAYAH_PARQUET=s3://syncrono-master/wilayah/master_wilayah_nik.parquet
WILAYAH_S3_ENDPOINT=
WILAYAH_S3_KEY=
WILAYAH_S3_SECRET=
WILAYAH_KECAMATAN_TEGAS=0

NORMALISASI_AI=nama_saja
NORMALISASI_AI_MODEL=gemma4:31b
NORMALISASI_AI_BASE_URL=
OLLAMA_API_KEY=

REASONING_AI_BASE_URL=
REASONING_AI_MODEL=gemma4:31b
REASONING_AI_API_KEY=
REASONING_AI_ALLOW_EXTERNAL=0

KONVERTER_URL=http://konverter:8390
KONVERTER_MSSQL_URL=http://konverter-mssql:8391
KONVERTER_ORACLE_URL=http://konverter-oracle:8392
KONVERTER_MYSQL_URL=http://konverter-mysql:8393

UDF_JAR_URL=

DUCKDB_MEMORY_LIMIT=3GB
GRADING_MAX_CONCURRENT=2
MATCHING_MAX_CONCURRENT=1

SERVICE_API_KEY=
SERVICE_SUPERUSER=admin
SERVICE_SUPERUSER_PASSWORD=
SERVICE_SECRET_KEY=
ACCESS_LOG=0
